namespace units;

struct Vector4 {
  x: float;
  y: float;
  z: float;
  w: float;
}

struct Vector3 {
  x: float;
  y: float;
  z: float;
}

struct Vector2 {
  x: float;
  y: float;
}

struct Matrix4x4 {
  m0: Vector4;
  m1: Vector4;
  m2: Vector4;
  m3: Vector4;
}

struct Matrix3x3 {
  m0: Vector3;
  m1: Vector3;
  m2: Vector3;
}

struct Color {
  r: float;
  g: float;
  b: float;
  a: float;
}

struct Quaternion {
  x: float;
  y: float;
  z: float;
  w: float;
}

